<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension" translationdomain="none">
  <name>Status</name>
  <id>org.dcc-mcp.menu.status</id>
  <effect needs-document="false" needs-live-preview="false" implements-custom-gui="true">
    <object-type>all</object-type>
    <effects-menu><submenu name="DCC MCP"/></effects-menu>
    <menu-tip>Inspect the installed private-profile adapter and actual connection readiness.</menu-tip>
  </effect>
  <script><command location="inx" interpreter="python">dcc_mcp_menu.py</command></script>
</inkscape-extension>
